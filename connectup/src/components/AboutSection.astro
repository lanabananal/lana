---
interface Props { locale: string; }

const c = {
  h2: 'A ponte entre você e o sistema que vai te libertar.',
  bio: 'Vim até o Paraguai para entender o sistema por dentro. Construí relacionamentos com advogados, contadores e especialistas locais; mapeei cada etapa do processo; e me tornei o elo que faltava para empreendedores e empresários que querem fazer isso com segurança. Hoje a ConnectUP atende pessoas do Brasil, Polônia, Espanha e de todo o mundo, com clareza, método e profissionais de confiança do início ao fim.',
  quote: 'Minha missão é simples: ajudar você a guardar mais do que ganha, de onde quer que você esteja.',
  bridgeCaption: 'ConnectUP — Estratégia e acompanhamento',
  stats: [{ n:'3+', l:'Continentes atendidos' }, { n:'100%', l:'Legal e seguro' }, { n:'1', l:'Ponto de contato para tudo' }],
  servicesTitle: 'O que fazemos',
  services: ['Residência fiscal no Paraguai', 'Abertura de empresa e Maquila', 'Planejamento tributário internacional', 'Consultoria estratégica personalizada'],
  valuesTitle: 'Nossos valores',
  values: ['Clareza antes de tudo', 'Só o que é legal', 'Estrutura própria, não improviso'],
};
---

<section style="background:#f7f4fa;padding:5rem 1.5rem;">
  <div style="max-width:1140px;margin:0 auto;">

    <!-- Headline + bio -->
    <div style="max-width:760px;margin:0 auto 3rem;text-align:center;">
      <h2 style="font-family:'Poppins',sans-serif;font-size:clamp(1.4rem,3vw,2rem);font-weight:600;line-height:1.3;margin-bottom:1.25rem;">{c.h2}</h2>
      <p style="font-family:'Poppins',sans-serif;font-size:0.95rem;font-weight:300;line-height:1.8;color:#444;margin-bottom:1.5rem;">{c.bio}</p>
      <blockquote style="border-left:3px solid #8417aa;background:#fff;padding:1rem 1.25rem;border-radius:0 8px 8px 0;font-family:'Poppins',sans-serif;font-size:0.9rem;font-weight:400;font-style:italic;color:#333;text-align:left;">
        {c.quote}
      </blockquote>
    </div>

    <!-- Bridge label + Stats -->
    <div style="text-align:center;margin-bottom:3rem;">
      <span style="display:inline-block;font-family:'Poppins',sans-serif;font-size:11px;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:#795389;background:#fff;border:1px solid #dfdede;padding:6px 16px;border-radius:99px;margin-bottom:2rem;">{c.bridgeCaption}</span>
      <div class="about-stats-grid">
        {c.stats.map((s: any) => (
          <div>
            <div style="font-family:'Poppins',sans-serif;font-size:2.2rem;font-weight:600;color:#8417aa;">{s.n}</div>
            <div style="font-family:'Poppins',sans-serif;font-size:0.82rem;font-weight:400;color:#795389;margin-top:4px;">{s.l}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Services + Values -->
    <div class="about-bottom-grid">
      <!-- O que fazemos -->
      <div>
        <h3 style="font-family:'Poppins',sans-serif;font-size:1.1rem;font-weight:600;margin-bottom:1rem;">{c.servicesTitle}</h3>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;" class="about-services-grid">
          {c.services.map((s: string, i: number) => (
            <div style={`border:1px solid #dfdede;border-radius:10px;padding:1rem 1.25rem;border-left:4px solid ${i % 2 === 0 ? '#8417aa' : '#07ffd2'};background:white;`}>
              <p style="font-family:'Poppins',sans-serif;font-size:0.88rem;font-weight:500;color:#1a1a1a;">{s}</p>
            </div>
          ))}
        </div>
      </div>
      <!-- Nossos valores -->
      <div>
        <h3 style="font-family:'Poppins',sans-serif;font-size:1.1rem;font-weight:600;margin-bottom:1rem;">{c.valuesTitle}</h3>
        <div style="display:flex;flex-direction:column;gap:0.75rem;">
          {c.values.map((v: string) => (
            <div style="background:white;border:1px solid #dfdede;border-radius:10px;padding:1rem 1.25rem;">
              <p style="font-family:'Poppins',sans-serif;font-size:0.88rem;font-weight:500;color:#1a1a1a;">{v}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<style>
.about-stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  max-width: 600px;
  margin: 0 auto;
  text-align: center;
}
.about-bottom-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
}
@media (max-width: 768px) {
  .about-stats-grid { grid-template-columns: repeat(2, 1fr); }
  .about-bottom-grid { grid-template-columns: 1fr; }
  .about-services-grid { grid-template-columns: 1fr !important; }
}
</style>
