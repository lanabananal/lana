---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getTranslations } from '../i18n/translations';

interface Props {
  locale: string;
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  pubDate?: Date;
  postAuthor?: string;
}

const { locale, title, description, ogType = 'website', pubDate, postAuthor } = Astro.props;
const t = getTranslations(locale);
const siteUrl = 'https://theconnectup.com';

const defaultTitle = 'ConnectUP — Residência Fiscal no Paraguai';
const defaultDesc = 'Residência fiscal, abertura de empresa e planejamento fiscal no Paraguai. Suporte jurídico completo para brasileiros que querem 0% de imposto sobre renda do exterior.';

const pageTitle = title ? `${title} | ConnectUP` : defaultTitle;
const pageDesc = description ?? defaultDesc ?? t.hero.subheadline;

const pageKeywords = 'residência fiscal Paraguai, cédula paraguaia, planejamento fiscal, imposto renda exterior, abertura empresa Paraguai, regime de maquila';

const canonicalPath = Astro.url.pathname;
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const ogImage = `${siteUrl}/C_COLORIDO.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${siteUrl}/#organization`,
      name: 'ConnectUP',
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/C_COLORIDO.png`,
      },
      image: `${siteUrl}/C_COLORIDO.png`,
      description: 'Paraguay tax residency services. Full legal support for cedula, RUC, company formation and tax planning for foreign income.',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Edificio Atrium',
        addressLocality: 'Asunción',
        addressRegion: 'Asunción',
        addressCountry: 'PY',
      },
      telephone: '+595991507955',
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+595991507955',
        contactType: 'customer service',
        availableLanguage: ['Portuguese', 'English', 'Spanish', 'Polish'],
      },
      sameAs: [
        'https://www.linkedin.com/company/theconnectup/',
        'https://www.youtube.com/@Connectupbr',
        'https://www.instagram.com/connectupbr/',
      ],
      areaServed: [
        { '@type': 'Country', name: 'Paraguay' },
        { '@type': 'Country', name: 'Brazil' },
        { '@type': 'Country', name: 'United States' },
        { '@type': 'Country', name: 'Poland' },
        { '@type': 'Country', name: 'Argentina' },
        { '@type': 'Country', name: 'Spain' },
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'ConnectUP Services',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Paraguay Tax Residency', description: 'Complete legal Paraguay tax residency including cedula, RUC and SET certificate. 0% tax on foreign income.' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Paraguay Company Formation', description: 'Full company registration in Paraguay — SAE, SRL or SA — with legal support.' } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Maquila Regime Services', description: 'Setup and compliance under Paraguay’s Maquila law for manufacturing and export companies.' } },
        ],
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'ConnectUP',
      publisher: { '@id': `${siteUrl}/#organization` },
    },
    {
      '@type': 'Service',
      '@id': `${siteUrl}/#service-tax`,
      name: 'Paraguay Tax Residency Consulting',
      provider: { '@id': `${siteUrl}/#organization` },
      description: 'Legal Paraguay tax residency process for individuals and companies. 0% tax on foreign income. Full legal support. Two trips to Asunción.',
      areaServed: { '@type': 'Country', name: 'Paraguay' },
      serviceType: 'Tax Planning & Residency Consulting',
    },
  ],
};
---
<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="robots" content="index, follow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />
    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="ConnectUP" />
    <meta property="og:locale" content="pt_BR" />
    {ogType === 'article' && pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}
    {ogType === 'article' && postAuthor && (
      <meta property="article:author" content={postAuthor} />
    )}
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" href="/C_COLORIDO.png" />
    <title>{pageTitle}</title>
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Navbar locale={locale} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
